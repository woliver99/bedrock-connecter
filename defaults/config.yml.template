# ==============================================================================
# MCXboxBroadcast Standalone Configuration
# Official Documentation: https://github.com/MCXboxBroadcast/Broadcaster
# ==============================================================================

session:
  # Session update interval in seconds (minimum 20 due to Xbox Live rate limits)
  update-interval: 30

  # Query BedrockConnect to sync session MOTD, player counts, etc.
  query-server: true

  # Fallback to checker.geysermc.org if native ping fails (helpful behind NAT/Docker)
  web-query-fallback: true

  # Fallback to session-info values below if queries fail
  config-fallback: true

  # The session information broadcasted over Xbox Live
  session-info:
    # Host name displayed on Xbox friends list (Leave empty to use your Xbox Gamertag)
    host-name: "BedrockConnect Server"
    # World name / sub-title displayed under the server in Xbox friends list
    world-name: "Custom Server Browser"
    # Game mode displayed in the session (Survival, Creative, Adventure)
    game-mode: "Survival"
    players: 0
    max-players: 100
    # The Public IP or domain name that external console players will connect to.
    # IMPORTANT: Do NOT use 127.0.0.1 or localhost here; external players must reach this address!
    ip: "auto"
    # Port of your BedrockConnect server (default Bedrock port is 19132)
    port: 19132

  # NetherNet WebRTC port range (0 = OS ephemeral dynamic port range)
  ice-port-range:
    min: 0
    max: 0

# Settings for automatically accepting and managing Xbox Live friends
friend-sync:
  # Interval in seconds to sync friends list (minimum 20)
  update-interval: 60
  # Automatically accept friend requests so new players can see the broadcast
  auto-friend: true
  # Send an automatic game invite when a new friend is added
  initial-invite: true
  expiry:
    # Automatically remove friends who have been inactive
    enabled: true
    # Days of inactivity before removing an Xbox friend
    days: 15
    # Interval in seconds to check for expired friends
    check: 1800

# Optional notification webhooks (Discord / Slack)
notifications:
  enabled: false
  # Discord webhook URL (append /slack to Discord webhook URLs)
  webhook-url: ""
  session-expired-message: |
    <!here> Xbox Session expired, sign in again to update it.
    Use the following link to sign in: %s
    Enter the code: %s
  friend-restriction-message: "%s (%s) has restrictions in place that prevent them from being friends with our account."

# Logging options
debug-mode: false
suppress-session-update-message: false
config-version: 5
